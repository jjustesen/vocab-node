# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# Supabase → Project Settings → API

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# A chave `service_role` NUNCA entra aqui. Ela vive só nas Edge Functions,
# como secret do Supabase — é ela que dá acesso ao banco ignorando o RLS.
